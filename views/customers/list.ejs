<%- include('../partials/head') %>
<%- include('../partials/sidebar', { activePage: 'customers' }) %>
<div class="main-content">
  <%- include('../partials/header', { pageTitle: 'Customers' }) %>
  <%- include('../partials/alerts') %>
  <div class="content-area">
    <div class="mb-3 d-flex justify-between align-center">
      <form action="/customers" method="GET" class="form-inline flex-grow-1" style="max-width:400px;">
        <input type="text" name="search" class="form-control" placeholder="Search name, phone, city..." value="<%= search %>">
        <button type="submit" class="btn btn-primary">Search</button>
        <% if (search) { %>
          <a href="/customers" class="btn btn-secondary">Clear</a>
        <% } %>
      </form>
      <div class="btn-group">
        <button type="button" class="btn btn-danger" id="btn-bulk-delete" disabled onclick="bulkDeleteCustomers()">Delete Selected</button>
        <button type="button" class="btn btn-danger" style="background:#b91c1c; font-weight:600;" onclick="deleteAllCustomers()">Delete All 🗑️</button>
        <a href="/customers/add" class="btn btn-primary">+ Add Customer</a>
      </div>
    </div>

    <div class="card">
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th style="width:40px;"><input type="checkbox" id="check-all" onclick="toggleAllChecks(this)"></th>
              <th>Name</th>
              <th>Phone</th>
              <th>Email</th>
              <th>City</th>
              <th>State</th>
              <th>GSTIN</th>
              <th class="no-print">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (customers.length === 0) { %>
              <tr><td colspan="8" class="table-empty">No customers found</td></tr>
            <% } %>
            <% customers.forEach(cust => { %>
              <tr>
                <td><input type="checkbox" class="customer-check" value="<%= cust.id %>" onclick="updateBulkButtons()"></td>
                <td class="fw-bold"><%= cust.name %></td>
                <td><%= cust.phone || '-' %></td>
                <td><%= cust.email || '-' %></td>
                <td><%= cust.city %></td>
                <td><%= cust.state %></td>
                <td><span class="badge badge-default"><%= cust.gstin || '-' %></span></td>
                <td class="no-print">
                  <div class="btn-group">
                    <a href="/customers/edit/<%= cust.id %>" class="btn btn-secondary btn-sm">Edit</a>
                    <form action="/customers/delete/<%= cust.id %>" method="POST" class="confirm-delete d-inline">
                      <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <% if (pagination.totalPages > 1) { %>
        <div class="pagination">
          <% 
            let startPage = Math.max(1, pagination.page - 2);
            let endPage = Math.min(pagination.totalPages, startPage + 4);
            startPage = Math.max(1, endPage - 4);
          %>
          <% if (startPage > 1) { %>
            <a href="/customers?page=1&search=<%= search %>">1</a>
            <% if (startPage > 2) { %><span>...</span><% } %>
          <% } %>
          
          <% for(let i=startPage; i<=endPage; i++) { %>
            <a href="/customers?page=<%= i %>&search=<%= search %>" class="<%= pagination.page === i ? 'active' : '' %>"><%= i %></a>
          <% } %>
          
          <% if (endPage < pagination.totalPages) { %>
            <% if (endPage < pagination.totalPages - 1) { %><span>...</span><% } %>
            <a href="/customers?page=<%= pagination.totalPages %>&search=<%= search %>"><%= pagination.totalPages %></a>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
</div>

<script>
  function toggleAllChecks(source) {
    const checkboxes = document.querySelectorAll('.customer-check');
    checkboxes.forEach(cb => cb.checked = source.checked);
    updateBulkButtons();
  }

  function updateBulkButtons() {
    const checkboxes = document.querySelectorAll('.customer-check:checked');
    const btnDelete = document.getElementById('btn-bulk-delete');
    if (btnDelete) btnDelete.disabled = checkboxes.length === 0;
  }

  function getSelectedIds() {
    const checkboxes = document.querySelectorAll('.customer-check:checked');
    return Array.from(checkboxes).map(cb => cb.value);
  }

  function bulkDeleteCustomers() {
    const ids = getSelectedIds();
    if (ids.length === 0) return;
    if (confirm('Are you sure you want to delete ' + ids.length + ' selected customers?')) {
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = '/customers/bulk-delete';
      const input = document.createElement('input');
      input.type = 'hidden';
      input.name = 'customer_ids';
      input.value = JSON.stringify(ids);
      form.appendChild(input);
      document.body.appendChild(form);
      form.submit();
    }
  }

  function deleteAllCustomers() {
    const confirmText = prompt('⚠️ DANGER: This will delete ALL customers in your database!\n\nType "DELETE ALL" to confirm:');
    if (confirmText === 'DELETE ALL') {
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = '/customers/delete-all';
      document.body.appendChild(form);
      form.submit();
    } else if (confirmText !== null) {
      alert('Action cancelled: You must type "DELETE ALL" exactly to confirm deletion.');
    }
  }
</script>
<%- include('../partials/footer') %>