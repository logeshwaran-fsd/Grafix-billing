<%- include('../partials/head') %>
<%- include('../partials/sidebar', { activePage: 'reports' }) %>
<div class="main-content">
  <%- include('../partials/header', { pageTitle: 'Reports' }) %>
  <%- include('../partials/alerts') %>
  <div class="content-area">
    <div class="grid grid-3">
      <div class="card stat-card accent-teal">
        <div class="stat-icon">📈</div>
        <h3 class="card-title mt-2">Sales Report</h3>
        <p class="text-secondary mt-1 fs-sm">Analyze revenue, invoice count, and tax collected over any time period.</p>
        <div class="d-flex gap-2 mt-3">
          <a href="/reports/sales" class="btn btn-primary btn-sm" style="flex:1;">View Report</a>
          <a href="/reports/export/sales" class="btn btn-success btn-sm" style="background:#10b981; border:none; font-weight:600;">Excel 📊</a>
        </div>
      </div>
      <div class="card stat-card accent-blue">
        <div class="stat-icon">📦</div>
        <h3 class="card-title mt-2">Stock Valuation</h3>
        <p class="text-secondary mt-1 fs-sm">Monitor current stock levels, branch stocks (Parrys & Ambattur), and valuation.</p>
        <div class="d-flex gap-2 mt-3">
          <a href="/reports/stock" class="btn btn-primary btn-sm" style="flex:1;">View Report</a>
          <a href="/reports/export/stock" class="btn btn-success btn-sm" style="background:#10b981; border:none; font-weight:600;">Excel 📊</a>
        </div>
      </div>
      <div class="card stat-card accent-purple">
        <div class="stat-icon">🔥</div>
        <h3 class="card-title mt-2">Top Products</h3>
        <p class="text-secondary mt-1 fs-sm">Identify top selling products sorted by sales quantity and gross revenue.</p>
        <div class="d-flex gap-2 mt-3">
          <a href="/reports/top-products" class="btn btn-primary btn-sm" style="flex:1;">View Report</a>
          <a href="/reports/export/top-products" class="btn btn-success btn-sm" style="background:#10b981; border:none; font-weight:600;">Excel 📊</a>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
