<%- include('../partials/head') %>
<%- include('../partials/sidebar', { activePage: 'reports' }) %>
<div class="main-content">
  <%- include('../partials/header', { pageTitle: 'Sales Reports' }) %>
  <%- include('../partials/alerts') %>
  <div class="content-area">
    <div class="mb-4 d-flex justify-between align-center">
      <a href="/reports" class="btn btn-secondary btn-sm">← Back to Reports</a>
      <form action="/reports/sales" method="GET" class="form-inline">
        <div class="form-group">
          <label class="small text-secondary">From Date</label>
          <input type="date" name="from" class="form-control" value="<%= from %>">
        </div>
        <div class="form-group">
          <label class="small text-secondary">To Date</label>
          <input type="date" name="to" class="form-control" value="<%= to %>">
        </div>
        <button type="submit" class="btn btn-primary" style="margin-top:20px;">Run Report</button>
      </form>
    </div>

    <div class="grid grid-3" style="margin-bottom:24px;">
      <div class="card stat-card accent-teal">
        <div class="stat-value">₹<%= (summary.total || 0).toLocaleString('en-IN', {minimumFractionDigits: 2}) %></div>
        <div class="stat-label">Total Revenue</div>
      </div>
      <div class="card stat-card accent-blue">
        <div class="stat-value"><%= summary.count || 0 %></div>
        <div class="stat-label">Total Invoices Raised</div>
      </div>
      <div class="card stat-card accent-purple">
        <div class="stat-value">₹<%= (summary.count > 0 ? (summary.total / summary.count) : 0).toLocaleString('en-IN', {minimumFractionDigits: 2}) %></div>
        <div class="stat-label">Average Order Value</div>
      </div>
    </div>

    <div class="card" style="margin-bottom:24px;">
      <div class="card-header"><h3 class="card-title">Daily Sales Trend</h3></div>
      <div style="height:300px; position:relative;">
        <canvas id="salesReportChart"></canvas>
      </div>
    </div>

    <div class="card">
      <div class="card-header"><h3 class="card-title">Detailed Sales Logs</h3></div>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Date</th>
              <th class="text-center">Bills Count</th>
              <th class="text-right">GST Collected</th>
              <th class="text-right">Total Revenue</th>
            </tr>
          </thead>
          <tbody>
            <% if (sales.length === 0) { %>
              <tr><td colspan="4" class="table-empty">No sales data in selected date range</td></tr>
            <% } %>
            <% sales.forEach(s => { %>
              <tr>
                <td class="fw-bold"><%= new Date(s.date).toLocaleDateString('en-IN') %></td>
                <td class="text-center"><%= s.count %></td>
                <td class="text-right text-muted">₹<%= s.tax.toLocaleString('en-IN', {minimumFractionDigits: 2}) %></td>
                <td class="text-right text-success fw-bold">₹<%= s.total.toLocaleString('en-IN', {minimumFractionDigits: 2}) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const reportData = <%- JSON.stringify(sales) %>;
    // Map backwards for left-to-right chronological order on line chart
    initSalesReportChart([...reportData].reverse());
  });
</script>
<%- include('../partials/footer') %>