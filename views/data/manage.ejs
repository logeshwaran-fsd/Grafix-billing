<%- include('../partials/head') %>
<%- include('../partials/sidebar', { activePage: 'data' }) %>
<div class="main-content">
  <%- include('../partials/header', { pageTitle: 'Import & Export Data' }) %>
  <%- include('../partials/alerts') %>
  <div class="content-area">
    <div class="grid grid-2">
      <!-- Export Card -->
      <div class="card">
        <div class="card-header"><h3 class="card-title">Backup & Export Data</h3></div>
        <p class="text-secondary mb-4 fs-sm">Download your database or tables as files to migrate servers or back up your records.</p>
        
        <div class="d-flex flex-column gap-3">
          <a href="/data/export/products" class="btn btn-primary btn-block">📥 Export Products (.xlsx)</a>
          <a href="/data/export/customers" class="btn btn-primary btn-block">📥 Export Customers (.xlsx)</a>
          <a href="/data/export/database" class="btn btn-warning btn-block">💾 Download SQLite Database File (.db)</a>
        </div>
      </div>

      <!-- Import Card -->
      <div class="card">
        <div class="card-header"><h3 class="card-title">Import Data from Excel</h3></div>
        <p class="text-secondary mb-4 fs-sm">Upload Excel (.xlsx) files to batch insert products or customers.</p>
        
        <div class="mb-4 pb-3" style="border-bottom: 1px solid var(--border, #334155);">
          <form action="/data/import/products" method="POST" enctype="multipart/form-data">
            <div class="form-group">
              <label for="import-file" class="fw-bold mb-1 d-block">Select Products Excel File (.xlsx)</label>
              <input type="file" id="import-file" name="file" class="form-control" accept=".xlsx" required>
            </div>
            <button type="submit" class="btn btn-success btn-block mt-2">🚀 Import Products</button>
          </form>
        </div>

        <div>
          <form action="/data/import/customers" method="POST" enctype="multipart/form-data">
            <div class="form-group">
              <label for="import-cust-file" class="fw-bold mb-1 d-block">Select Customers Excel File (.xlsx)</label>
              <input type="file" id="import-cust-file" name="file" class="form-control" accept=".xlsx" required>
            </div>
            <button type="submit" class="btn btn-primary btn-block mt-2">👥 Import Customers</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>