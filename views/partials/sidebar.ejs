<div class="sidebar no-print">
  <div class="sidebar-logo" style="justify-content: center; padding: 20px 10px;">
    <img src="/images/logo.png" alt="Grafix Impression" style="max-height: 40px; max-width: 100%; object-fit: contain;">
  </div>
  <div class="sidebar-nav">
    <a href="/dashboard" class="sidebar-link <%= activePage === 'dashboard' ? 'active' : '' %>">
      <span class="icon">📊</span> Dashboard
    </a>
    <a href="/products" class="sidebar-link <%= activePage === 'products' ? 'active' : '' %>">
      <span class="icon">📦</span> Products
    </a>

    <a href="/categories" class="sidebar-link <%= activePage === 'categories' ? 'active' : '' %>">
      <span class="icon">📁</span> Brands
    </a>
    <a href="/branches" class="sidebar-link <%= activePage === 'branches' ? 'active' : '' %>">
      <span class="icon">🏢</span> Branches
    </a>
    <a href="/customers" class="sidebar-link <%= activePage === 'customers' ? 'active' : '' %>">
      <span class="icon">👥</span> Customers
    </a>
    <a href="/credit" class="sidebar-link <%= activePage === 'credit' ? 'active' : '' %>">
      <span class="icon">💰</span> Credit / Dues
    </a>
    <a href="/billing/new" class="sidebar-link <%= activePage === 'billing-new' ? 'active' : '' %>">
      <span class="icon">🧾</span> New Invoice
    </a>
    <a href="/billing" class="sidebar-link <%= activePage === 'billing' ? 'active' : '' %>">
      <span class="icon">📋</span> Invoices
    </a>
    <a href="/inventory" class="sidebar-link <%= activePage === 'inventory' ? 'active' : '' %>">
      <span class="icon">📈</span> Stock
    </a>
    <% if (user && user.role === 'admin') { %>
      <a href="/reports" class="sidebar-link <%= activePage === 'reports' ? 'active' : '' %>">
        <span class="icon">📈</span> Reports
      </a>
      <a href="/tally/ledger" class="sidebar-link <%= activePage === 'tally' ? 'active' : '' %>">
        <span class="icon">📔</span> Tally Ledger
      </a>
      <a href="/data" class="sidebar-link <%= activePage === 'data' ? 'active' : '' %>">
        <span class="icon">💾</span> Import/Export
      </a>
      <div class="sidebar-divider"></div>
      <a href="/users" class="sidebar-link <%= activePage === 'users' ? 'active' : '' %>">
        <span class="icon">👤</span> Users
      </a>
      <a href="/settings" class="sidebar-link <%= activePage === 'settings' ? 'active' : '' %>">
        <span class="icon">⚙️</span> Settings
      </a>
    <% } %>
  </div>
</div>