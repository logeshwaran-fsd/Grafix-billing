<%- include('../partials/head') %>
<%- include('../partials/sidebar', { activePage: 'categories' }) %>
<div class="main-content">
  <%- include('../partials/header', { pageTitle: 'Brands' }) %>
  <%- include('../partials/alerts') %>
  <div class="content-area">
    <div class="grid grid-3">
      <div class="card" style="grid-column: span 1;">
        <div class="card-header"><h3 class="card-title">Add New Brand</h3></div>
        <form action="/categories/add" method="POST">
          <div class="form-group">
            <label for="name">Brand Name *</label>
            <input type="text" id="name" name="name" class="form-control" required placeholder="e.g. Shiny, Polymer">
          </div>
          <div class="form-group">
            <label for="description">Description</label>
            <textarea id="description" name="description" class="form-control" rows="3" placeholder="Brand description"></textarea>
          </div>
          <button type="submit" class="btn btn-primary btn-block mt-3">Add Brand</button>
        </form>
      </div>

      <div class="card" style="grid-column: span 2;">
        <div class="card-header"><h3 class="card-title">All Brands</h3></div>
        <div class="table-container">
          <table>
            <thead>
              <tr>
                <th>Brand Name</th>
                <th>Description</th>
                <th class="text-center">Count</th>
                <th>Items (In Database)</th>
                <th class="no-print">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (categories.length === 0) { %>
                <tr><td colspan="5" class="table-empty">No brands added yet</td></tr>
              <% } %>
              <% categories.forEach(cat => { %>
                <tr>
                  <td class="fw-bold"><%= cat.name %></td>
                  <td class="text-secondary"><%= cat.description || 'No description' %></td>
                  <td class="text-center"><span class="badge badge-default"><%= cat.product_count %></span></td>
                  <td class="text-secondary" style="font-size: 12px; max-width: 300px; white-space: normal;"><%= cat.product_names || 'None' %></td>
                  <td class="no-print">
                    <button type="button" class="btn btn-secondary btn-sm d-inline" onclick="openEditBrandModal('<%= cat.id %>', '<%= cat.name.replace(/'/g, "\\'") %>', '<%= (cat.description || '').replace(/'/g, "\\'") %>')">Edit</button>
                    <form action="/categories/delete/<%= cat.id %>" method="POST" class="confirm-delete d-inline">
                      <button type="submit" class="btn btn-danger btn-sm" <%= cat.product_count > 0 ? 'disabled' : '' %>>Delete</button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Edit Brand Modal -->
<div id="edit-brand-modal" class="modal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1050; align-items:center; justify-content:center;">
  <div class="modal-content" style="background:var(--bg-card); padding:24px; border-radius:8px; width:100%; max-width:400px; box-shadow: 0 10px 25px rgba(0,0,0,0.5); border:1px solid var(--border);">
    <h3 style="margin-top:0; color:var(--text-primary);">Edit Brand</h3>
    <form id="edit-brand-form" method="POST" action="">
      <div class="form-group">
        <label>Brand Name *</label>
        <input type="text" id="edit-brand-name" name="name" class="form-control" required>
      </div>
      <div class="form-group">
        <label>Description</label>
        <textarea id="edit-brand-desc" name="description" class="form-control" rows="3"></textarea>
      </div>
      <div class="d-flex justify-between mt-4">
        <button type="button" class="btn btn-secondary" onclick="document.getElementById('edit-brand-modal').style.display='none'">Cancel</button>
        <button type="submit" class="btn btn-success">Update Brand</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openEditBrandModal(id, name, desc) {
    document.getElementById('edit-brand-form').action = '/categories/edit/' + id;
    document.getElementById('edit-brand-name').value = name;
    document.getElementById('edit-brand-desc').value = desc;
    document.getElementById('edit-brand-modal').style.display = 'flex';
  }
</script>
<%- include('../partials/footer') %>