<%- include('../partials/head') %>
<%- include('../partials/sidebar', { activePage: 'inventory' }) %>
<div class="main-content">
  <%- include('../partials/header', { pageTitle: 'Stock Transaction History' }) %>
  <div class="content-area">
    <div class="d-flex justify-between align-center mb-3">
      <a href="/inventory" class="btn btn-secondary">← Back to Stock</a>
      <span class="text-secondary" style="font-size:13px; font-weight:600;">Total Transactions: <%= pagination.totalCount %></span>
    </div>

    <!-- Filter Bar -->
    <div class="card mb-3" style="padding:14px 16px;">
      <form method="GET" action="/inventory/transactions" class="d-flex gap-2 align-center flex-wrap">
        <div style="flex:1; min-width:200px;">
          <input type="text" name="search" class="form-control" placeholder="Search by Product Name, Code, or Notes..." value="<%= search %>">
        </div>
        <div style="width:160px;">
          <select name="type" class="form-control">
            <option value="">All Types</option>
            <option value="sale" <%= selectedType === 'sale' ? 'selected' : '' %>>Sale</option>
            <option value="purchase" <%= selectedType === 'purchase' ? 'selected' : '' %>>Purchase / Add</option>
            <option value="adjustment" <%= selectedType === 'adjustment' ? 'selected' : '' %>>Adjustment</option>
            <option value="return" <%= selectedType === 'return' ? 'selected' : '' %>>Return</option>
          </select>
        </div>
        <button type="submit" class="btn btn-primary" style="padding:8px 18px; font-weight:600;">Filter</button>
        <% if (search || selectedType) { %>
          <a href="/inventory/transactions" class="btn btn-secondary">Reset</a>
        <% } %>
      </form>
    </div>

    <div class="card">
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Date & Time</th>
              <th>Code</th>
              <th>Product Name</th>
              <th>Type</th>
              <th>Change Qty</th>
              <th>User / Performed By</th>
              <th>Notes / Reason</th>
            </tr>
          </thead>
          <tbody>
            <% if (transactions.length === 0) { %>
              <tr><td colspan="7" class="table-empty" style="text-align:center; padding:24px;">No stock transactions found matching your criteria.</td></tr>
            <% } %>
            <% transactions.forEach(tx => { %>
              <tr>
                <td style="white-space:nowrap; font-size:12px; color:var(--text-secondary);"><%= new Date(tx.created_at).toLocaleString('en-IN') %></td>
                <td><span class="badge badge-default" style="font-weight:700;"><%= tx.product_code %></span></td>
                <td class="fw-bold" style="color:var(--text-primary);"><%= tx.product_name %></td>
                <td>
                  <span class="badge <%= tx.type==='sale' ? 'badge-info' : (tx.type==='purchase'?'badge-success':'badge-warning') %>" style="text-transform:uppercase; font-size:11px; font-weight:700;">
                    <%= tx.type %>
                  </span>
                </td>
                <td class="fw-bold <%= tx.quantity > 0 ? 'text-success' : 'text-danger' %>" style="font-size:14px;">
                  <%= tx.quantity > 0 ? '+' : '' %><%= tx.quantity %>
                </td>
                <td style="font-size:13px;"><%= tx.user_name || 'System / Admin' %></td>
                <td style="font-size:12px; color:var(--text-secondary);"><%= tx.notes %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <% if (pagination.totalPages > 1) { %>
        <div class="d-flex justify-between align-center p-3" style="border-top:1px solid var(--border); margin-top:10px;">
          <div class="text-secondary" style="font-size:13px;">
            Showing Page <%= pagination.page %> of <%= pagination.totalPages %> (<%= pagination.totalCount %> records)
          </div>
          <div class="d-flex gap-1">
            <% if (pagination.page > 1) { %>
              <a href="/inventory/transactions?page=<%= pagination.page - 1 %>&search=<%= encodeURIComponent(search) %>&type=<%= selectedType %>" class="btn btn-secondary btn-sm">Previous</a>
            <% } %>
            <% for (let p = Math.max(1, pagination.page - 2); p <= Math.min(pagination.totalPages, pagination.page + 2); p++) { %>
              <a href="/inventory/transactions?page=<%= p %>&search=<%= encodeURIComponent(search) %>&type=<%= selectedType %>" class="btn <%= p === pagination.page ? 'btn-primary' : 'btn-secondary' %> btn-sm"><%= p %></a>
            <% } %>
            <% if (pagination.page < pagination.totalPages) { %>
              <a href="/inventory/transactions?page=<%= pagination.page + 1 %>&search=<%= encodeURIComponent(search) %>&type=<%= selectedType %>" class="btn btn-secondary btn-sm">Next</a>
            <% } %>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>