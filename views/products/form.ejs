<%- include('../partials/head') %>
<%- include('../partials/sidebar', { activePage: 'products' }) %>
<div class="main-content">
  <%- include('../partials/header', { pageTitle: product ? 'Edit Product' : 'Add Product' }) %>
  <%- include('../partials/alerts') %>
  <div class="content-area">
    <div class="card" style="max-width:800px;">
      <form action="<%= product ? '/products/edit/' + product.id : '/products/add' %>" method="POST">
        <div class="form-row">
          <div class="form-group">
            <label for="code">Product Code / SKU *</label>
            <input type="text" id="code" name="code" class="form-control" value="<%= product ? product.code : '' %>" required placeholder="e.g. 001">
          </div>
          <div class="form-group">
            <label for="name">Product Name *</label>
            <input type="text" id="name" name="name" class="form-control" value="<%= product ? product.name : '' %>" required placeholder="e.g. Polymer Plate">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>Brand</label>
            <select name="category_id" class="form-control">
              <option value="">No Brand</option>
              <% categories.forEach(cat => { %>
                <option value="<%= cat.id %>" <%= product && product.category_id == cat.id ? 'selected' : '' %>><%= cat.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label for="unit">Unit of Measure</label>
            <select id="unit" name="unit" class="form-control">
              <% ['pcs', 'ltr', 'kg', 'roll', 'box', 'set'].forEach(u => { %>
                <option value="<%= u %>" <%= (product && product.unit === u) ? 'selected' : '' %>><%= u %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="unit_price">Selling Price (₹) *</label>
            <input type="number" id="unit_price" name="unit_price" class="form-control" step="0.01" value="<%= product ? product.unit_price : 0 %>" required>
          </div>
          <div class="form-group">
            <label for="cost_price">Cost Price (₹) *</label>
            <input type="number" id="cost_price" name="cost_price" class="form-control" step="0.01" value="<%= product ? product.cost_price : 0 %>" required>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group" style="flex: 2;">
            <label>Branch Stocks *</label>
            <div class="d-flex" style="gap: 10px; flex-wrap: wrap;">
              <% branches.forEach(b => { 
                  let currentStock = 0;
                  if (product && product.branch_stocks && product.branch_stocks[b.name] !== undefined) {
                      currentStock = product.branch_stocks[b.name];
                  }
              %>
                <div style="flex: 1; min-width: 120px;">
                  <label style="font-size: 0.85em; color: var(--text-light);"><%= b.name %></label>
                  <input type="number" name="branch_<%= b.name %>" class="form-control branch-stock-input" value="<%= currentStock %>" required>
                </div>
              <% }) %>
            </div>
          </div>
          <div class="form-group" style="flex: 1;">
            <label>Total Stock</label>
            <input type="number" id="stock_quantity" class="form-control" value="<%= product ? product.stock_quantity : 0 %>" disabled style="background-color: #f1f3f5; font-weight: bold;">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="reorder_level">Reorder (Low Stock) Level</label>
            <input type="number" id="reorder_level" name="reorder_level" class="form-control" value="<%= product ? product.reorder_level : 10 %>">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="hsn_code">HSN Code</label>
            <input type="text" id="hsn_code" name="hsn_code" class="form-control" value="<%= product ? product.hsn_code : '' %>">
          </div>
          <div class="form-group">
            <label for="gst_rate">GST Rate (%)</label>
            <select id="gst_rate" name="gst_rate" class="form-control">
              <% [0, 5, 12, 18, 28].forEach(r => { %>
                <option value="<%= r %>" <%= (product && product.gst_rate == r) ? 'selected' : (r == 18 ? 'selected' : '') %>><%= r %>%</option>
              <% }) %>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label for="description">Description</label>
          <textarea id="description" name="description" class="form-control" rows="3"><%= product ? product.description : '' %></textarea>
        </div>

        <div class="btn-group mt-3">
          <button type="submit" class="btn btn-primary">Save Product</button>
          <a href="/products" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('.branch-stock-input').forEach(input => {
    input.addEventListener('input', () => {
      let total = 0;
      document.querySelectorAll('.branch-stock-input').forEach(inp => {
        total += parseInt(inp.value) || 0;
      });
      document.getElementById('stock_quantity').value = total;
    });
  });
</script>
<%- include('../partials/footer') %>