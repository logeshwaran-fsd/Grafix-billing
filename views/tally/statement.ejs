<%- include('../partials/head') %>
<%- include('../partials/sidebar', { activePage: 'tally' }) %>
<div class="main-content">
  <%- include('../partials/header', { pageTitle: 'Ledger Statement' }) %>
  <%- include('../partials/alerts') %>
  <div class="content-area">
    
    <div class="mb-3 d-flex gap-2 no-print">
      <a href="/tally/ledger" class="btn btn-secondary">← Back to Ledgers</a>
      <button onclick="window.print()" class="btn btn-primary">Print Statement 🖨️</button>
      <button onclick="downloadPDF()" class="btn btn-success">Download PDF 📄</button>
    </div>

    <!-- Statement Card for Print -->
    <div class="card invoice-print-area" id="statement-card" style="background:#fff; color:#1e293b; max-width:850px; margin: 0 auto; padding:40px; border-radius:8px; border:1px solid #e2e8f0; font-family:'Inter', sans-serif;">
      
      <!-- Company Branding Header -->
      <div style="display:flex; justify-content:space-between; border-bottom:2px solid #e2e8f0; padding-bottom:20px; margin-bottom:24px;">
        <div>
          <img src="/images/logo.png" alt="Logo" style="max-height: 45px; margin-bottom: 10px; display: block;">
          <h2 style="font-size:20px; font-weight:800; color:#0f172a; margin-bottom:4px;"><%= settings.company_name || 'Grafix Impression' %></h2>
          <p style="font-size:12px; color:#64748b; line-height:1.4;"><%= settings.company_address || 'Chennai' %></p>
        </div>
        <div style="text-align:right;">
          <h1 style="font-size:24px; font-weight:800; color:#14b8a6; margin-bottom:8px;">STATEMENT OF ACCOUNT</h1>
          <p style="font-size:13px; margin-bottom:4px; color:#475569;"><strong>Date Generated:</strong> <%= new Date().toLocaleDateString('en-IN') %></p>
        </div>
      </div>

      <!-- Account Details -->
      <div style="display:grid; grid-template-columns: 1fr 1fr; gap:20px; margin-bottom:32px; background:#f8fafc; padding:20px; border-radius:6px; border:1px solid #e2e8f0;">
        <div>
          <h4 style="font-size:11px; text-transform:uppercase; color:#64748b; letter-spacing:0.5px; margin-bottom:6px;">Account Holder:</h4>
          <h3 style="font-size:16px; font-weight:700; color:#0f172a; margin-bottom:4px;"><%= customer.name %></h3>
          <% if (customer.address) { %><p style="font-size:13px; color:#475569; margin-bottom:2px; max-width:300px;"><%= customer.address %></p><% } %>
          <% if (customer.phone) { %><p style="font-size:13px; color:#475569; margin-bottom:2px;">Phone: <%= customer.phone %></p><% } %>
        </div>
        <div style="text-align: right; display: flex; flex-direction: column; justify-content: center;">
          <div style="font-size: 13px; color:#64748b; margin-bottom: 4px;">Opening Balance: <span style="font-weight: 600; color:#0f172a;">₹<%= (customer.opening_balance || 0).toFixed(2) %></span></div>
          <div style="font-size: 18px; font-weight:800; color:#e2e8f0; background: #0f172a; padding: 10px 16px; border-radius: 6px; display: inline-block; margin-left: auto;">
            Net Outstanding: <span style="color:#f59e0b;">₹<%= closingBalance.toLocaleString('en-IN', {minimumFractionDigits: 2}) %></span>
          </div>
        </div>
      </div>

      <!-- Transactions Listing -->
      <table style="width:100%; border-collapse:collapse; font-size:13px; margin-bottom:24px;">
        <thead>
          <tr style="border-bottom:2px solid #cbd5e1; text-align:left; color:#475569; font-weight:700;">
            <th style="padding:10px 8px;">Date</th>
            <th style="padding:10px 8px;">Type</th>
            <th style="padding:10px 8px;">Ref / Description</th>
            <th style="padding:10px 8px; text-align:right;">Debit (Sales)</th>
            <th style="padding:10px 8px; text-align:right;">Credit (Payments)</th>
            <th style="padding:10px 8px; text-align:right;">Balance</th>
          </tr>
        </thead>
        <tbody>
          <!-- Opening Balance row -->
          <tr style="border-bottom:1px solid #e2e8f0; background: #f8fafc;">
            <td style="padding:12px 8px;" colspan="3"><strong>Opening Balance / Carry Forward</strong></td>
            <td style="padding:12px 8px; text-align:right;">-</td>
            <td style="padding:12px 8px; text-align:right;">-</td>
            <td style="padding:12px 8px; text-align:right; font-weight:600;">₹<%= (customer.opening_balance || 0).toFixed(2) %></td>
          </tr>
          
          <% entries.forEach(tx => { %>
            <tr style="border-bottom:1px solid #e2e8f0;">
              <td style="padding:12px 8px;"><%= new Date(tx.date).toLocaleDateString('en-IN') %></td>
              <td style="padding:12px 8px; font-weight:600;"><%= tx.type %></td>
              <td style="padding:12px 8px; color:#475569;"><%= tx.reference %> (<%= tx.invoice_type %>)</td>
              <td style="padding:12px 8px; text-align:right; color:#ef4444;"><%= tx.debit > 0 ? `₹${tx.debit.toFixed(2)}` : '-' %></td>
              <td style="padding:12px 8px; text-align:right; color:#10b981;"><%= tx.credit > 0 ? `₹${tx.credit.toFixed(2)}` : '-' %></td>
              <td style="padding:12px 8px; text-align:right; font-weight:600;">₹<%= tx.running_balance.toLocaleString('en-IN', {minimumFractionDigits: 2}) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>

      <!-- Statement Footer Summary -->
      <div style="border-top:2px solid #cbd5e1; padding-top:16px; font-size:13px; display:flex; justify-content:space-between; color:#475569;">
        <div>
          <span>Statement generated securely.</span>
        </div>
        <div style="text-align:right; min-width: 250px;">
          <div style="display:flex; justify-content:space-between; margin-bottom:4px;">
            <span>Total Debited (Sales):</span>
            <span style="font-weight:600; color:#ef4444;">₹<%= entries.reduce((s,x)=>s+x.debit, 0).toFixed(2) %></span>
          </div>
          <div style="display:flex; justify-content:space-between; margin-bottom:4px;">
            <span>Total Credited (Paid):</span>
            <span style="font-weight:600; color:#10b981;">₹<%= entries.reduce((s,x)=>s+x.credit, 0).toFixed(2) %></span>
          </div>
          <div style="display:flex; justify-content:space-between; margin-top:8px; border-top:1px solid #cbd5e1; padding-top:8px; font-size:15px; font-weight:700; color:#0f172a;">
            <span>Closing Balance:</span>
            <span>₹<%= closingBalance.toLocaleString('en-IN', {minimumFractionDigits: 2}) %></span>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  function downloadPDF() {
    const element = document.getElementById('statement-card');
    const opt = {
      margin:       10,
      filename:     'Statement_<%= customer.name.replace(/\s+/g, "_") %>_<%= new Date().toISOString().split("T")[0] %>.pdf',
      image:        { type: 'jpeg', quality: 0.98 },
      html2canvas:  { scale: 2, useCORS: true },
      jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
    };
    html2pdf().from(element).set(opt).save();
  }
</script>

<%- include('../partials/footer') %>
