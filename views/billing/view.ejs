<%- include('../partials/head') %>
<%- include('../partials/sidebar', { activePage: 'billing' }) %>
<% const isEst = (invoice.invoice_type === 'estimate'); %>
<div class="main-content">
  <%- include('../partials/header', { pageTitle: 'Invoice Details' }) %>
  <%- include('../partials/alerts') %>
  <div class="content-area">
    <div class="mb-3 d-flex gap-2 no-print" style="align-items: center; flex-wrap: wrap;">
      <a href="/billing" class="btn btn-secondary">← Back to Invoices</a>
      
      <% if (!isEst) { %>
        <select id="print-copy-type" class="form-control" style="width: auto; height: 38px; display: inline-block; background: var(--bg-input); border: 1px solid var(--border); color:#fff; border-radius:8px; padding:0 10px;" onchange="updatePrintCopyBadge()">
          <option value="original" selected>Original Copy (Buyer)</option>
          <option value="duplicate">Duplicate Copy (Transporter)</option>
          <option value="office">Office Copy</option>
        </select>
      <% } %>
      
      <button onclick="window.print()" class="btn btn-primary">Print 🖨️</button>
      <button onclick="downloadPDF()" class="btn btn-success">Download PDF 📄</button>
      <a href="/billing/new?clone=<%= invoice.id %>" class="btn btn-warning" style="background:#f59e0b; color:#fff; font-weight:600; border:none; padding:10px 20px; border-radius:8px; display:inline-flex; align-items:center; gap:8px;">Clone Bill 📄</a>
      <% if (user && user.role === 'admin') { %>
        <a href="/billing/<%= invoice.id %>/edit" class="btn btn-primary" style="background:#6366f1; border:none;">Edit Invoice ✏️</a>
      <% } %>
      
      <% if (invoice.payment_status !== 'cancelled' && user && user.role === 'admin') { %>
        <form action="/billing/<%= invoice.id %>/cancel" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to cancel this invoice? This will restore stock levels.')">
          <button type="submit" class="btn btn-danger">Cancel Invoice</button>
        </form>
      <% } %>
      
      <% if (user && user.role === 'admin') { %>
        <form action="/billing/<%= invoice.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Are you absolutely sure you want to DELETE this invoice entirely? This cannot be undone.')">
          <button type="submit" class="btn btn-danger" style="background:#dc2626; border:none;">Delete Invoice 🗑️</button>
        </form>
      <% } %>
    </div>

    <style>
      @media print {
        @page { size: A6 portrait; margin: 5px 1px 0px 1px; }
        body, .invoice-print-area { font-family: Arial, sans-serif !important; font-stretch: normal !important; margin: 0 !important; }
        #invoice-card { padding: 0 !important; max-width: 100% !important; border: none !important; border-radius: 0 !important; font-size: 9px !important; }
        .invoice-print-area table { margin-bottom: 12px !important; }
        .invoice-print-area table th, .invoice-print-area table td { padding: 3px 4px !important; font-size: 9px !important; white-space: nowrap !important; }
        .invoice-print-area table td:nth-child(2) { max-width: 140px; overflow: hidden; text-overflow: ellipsis; }
        .invoice-print-area h1 { font-size: 16px !important; margin-bottom: 2px !important; margin-top: 0 !important; }
        .invoice-print-area p { margin-bottom: 2px !important; font-size: 9px !important; }
      }
      
      /* Single-Page A6 PDF Export Mode */
      .pdf-single-page-export {
        width: 395px !important;
        max-width: 395px !important;
        min-width: 395px !important;
        padding: 6px 12px 6px 8px !important;
        margin: 0 !important;
        font-size: 7.5px !important;
        font-family: Arial, sans-serif !important;
        background: #ffffff !important;
        border: none !important;
        box-shadow: none !important;
      }
      .pdf-single-page-export * {
        box-sizing: border-box !important;
      }
      .pdf-single-page-export table {
        width: 100% !important;
        margin-bottom: 4px !important;
        table-layout: fixed !important;
      }
      .pdf-single-page-export th, .pdf-single-page-export td {
        padding: 1.5px 2px !important;
        font-size: 7.5px !important;
        line-height: 1.1 !important;
      }
      .pdf-single-page-export th:nth-child(1), .pdf-single-page-export td:nth-child(1) { width: 18px !important; }
      .pdf-single-page-export th:nth-child(2), .pdf-single-page-export td:nth-child(2) { width: 130px !important; overflow: hidden !important; text-overflow: ellipsis !important; white-space: nowrap !important; }
      .pdf-single-page-export th:nth-child(3), .pdf-single-page-export td:nth-child(3) { width: 28px !important; text-align: center !important; }
      .pdf-single-page-export th:nth-child(4), .pdf-single-page-export td:nth-child(4) { width: 55px !important; text-align: right !important; }
      .pdf-single-page-export th:nth-child(5), .pdf-single-page-export td:nth-child(5) { width: 45px !important; text-align: right !important; }
      <% if (!isEst) { %>
        .pdf-single-page-export th:nth-child(6), .pdf-single-page-export td:nth-child(6) { width: 35px !important; text-align: center !important; }
        .pdf-single-page-export th:nth-child(7), .pdf-single-page-export td:nth-child(7) { width: 60px !important; text-align: right !important; }
      <% } else { %>
        .pdf-single-page-export th:nth-child(6), .pdf-single-page-export td:nth-child(6) { width: 60px !important; text-align: right !important; }
      <% } %>
      .pdf-single-page-export h1 { font-size: 13px !important; margin: 0 0 2px 0 !important; }
      .pdf-single-page-export p { font-size: 7.5px !important; line-height: 1.1 !important; margin-bottom: 1px !important; }
      .pdf-single-page-export img { max-height: 25px !important; margin-bottom: 4px !important; }
    </style>
    <div class="card invoice-print-area" id="invoice-card" style="background:#fff; color:#1e293b; max-width:850px; margin: 0 auto; padding:40px; border-radius:8px; border:1px solid #e2e8f0; font-family:'Inter', sans-serif;">
      <!-- Invoice Header & Customer Details Compacted -->
      <div style="display:flex; justify-content:space-between; border-bottom:2px solid #e2e8f0; padding-bottom:12px; margin-bottom:12px;">
        <div>
          <img src="/images/logo.png" alt="Logo" style="max-height: 45px; margin-bottom: 10px; display: block;">
          <p style="font-size:14px; color:#64748b; line-height:1.4;">
            No. 32 Anderson Street,<br>
            Parrys, Chennai-600001<br>
            Ph: +91 44 2536 1094<br>
            grafiximpressionparrys@gmail.com
          </p>
        </div>
        <div style="text-align:right; display:flex; flex-direction:column; align-items:flex-end;">
          <% if (!isEst) { %>
            <!-- Badge removed -->
          <% } %>
          <h1 style="font-size:24px; font-weight:800; color:#14b8a6; margin-bottom:8px; margin-top:0;">ESTIMATE</h1>
          <p style="font-size:14px; margin-bottom:4px;"><strong>Estimate #:</strong> <%= invoice.invoice_number %></p>
          <p style="font-size:14px; margin-bottom:4px;"><strong>Date:</strong> <%= new Date(invoice.created_at).toLocaleDateString('en-IN') %></p>
          <p style="font-size:14px; margin-bottom:8px;"><strong>Status:</strong> <span style="text-transform:uppercase; font-weight:700; color: <%= invoice.payment_status === 'paid' ? '#10b981' : (invoice.payment_status === 'pending' ? '#f59e0b' : '#ef4444') %>"><%= invoice.payment_status %></span></p>
          
          <div style="text-align:right; max-width: 250px; margin-top:10px;">
            <p style="font-size:10px; text-transform:uppercase; color:#64748b; letter-spacing:0.5px; margin-bottom:2px;"><%= isEst ? 'Estimate For:' : 'Billed To:' %></p>
            <p style="font-size:13px; font-weight:700; color:#000; margin-bottom:2px;"><%= invoice.customer_name || 'Walk-in Customer' %></p>
            <% if (invoice.customer_phone) { %><p style="font-size:11px; color:#000; margin-bottom:0;">Phone: <%= invoice.customer_phone %></p><% } %>
            <% if (!isEst && invoice.customer_gstin) { %><p style="font-size:11px; color:#000; margin-bottom:0;">GSTIN: <%= invoice.customer_gstin %></p><% } %>
            <% if (invoice.customer_address) { %><p style="font-size:11px; color:#000; margin-bottom:0; max-width: 220px; margin-left: auto; word-wrap: break-word;"><%= invoice.customer_address %></p><% } %>
          </div>
        </div>
      </div>

      <!-- Items Table -->
      <table style="width:100%; border-collapse:collapse; margin-bottom:32px;">
        <thead>
          <tr style="background:#f1f5f9; border-bottom:2px solid #cbd5e1;">
            <th style="padding:12px; text-align:left; font-size:12px; font-weight:700; color:#475569;">#</th>
            <th style="padding:12px; text-align:left; font-size:12px; font-weight:700; color:#475569;">Product</th>
            <th style="padding:12px; text-align:center; font-size:12px; font-weight:700; color:#475569;">Qty</th>
            <th style="padding:12px; text-align:right; font-size:12px; font-weight:700; color:#475569;">Rate</th>
            <th style="padding:12px; text-align:right; font-size:12px; font-weight:700; color:#475569;">Disc</th>
            <% if (!isEst) { %>
              <th style="padding:12px; text-align:center; font-size:12px; font-weight:700; color:#475569;">GST</th>
            <% } %>
            <th style="padding:12px; text-align:right; font-size:12px; font-weight:700; color:#475569;">Total</th>
          </tr>
        </thead>
        <tbody>
          <% items.forEach((item, index) => { %>
            <tr style="border-bottom:1px solid #e2e8f0;">
              <td style="padding:12px; font-size:14px;"><%= index + 1 %></td>
              <td style="padding:12px; font-size:14px; font-weight:600;"><%= item.product_name %></td>
              <td style="padding:12px; font-size:14px; text-align:center;"><%= item.quantity %></td>
              <td style="padding:12px; font-size:14px; text-align:right;">₹<%= item.unit_price.toFixed(2) %></td>
              <td style="padding:12px; font-size:14px; text-align:right;">₹<%= item.discount.toFixed(2) %></td>
              <% if (!isEst) { %>
                <td style="padding:12px; font-size:14px; text-align:center;"><%= item.tax_rate %>%</td>
              <% } %>
              <td style="padding:12px; font-size:14px; text-align:right; font-weight:600;">₹<%= item.total.toFixed(2) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>

      <!-- Summary -->
      <div style="display:flex; justify-content:space-between;">
        <div style="max-width:350px; font-size:13px; color:#64748b;">
          <p style="margin-bottom:8px;"><strong>Payment Method:</strong> <span style="text-transform:uppercase;"><%= invoice.payment_method %></span></p>
        </div>
        <div style="min-width:240px; font-size:14px;">
          <div style="display:flex; justify-content:space-between; margin-bottom:8px;">
            <span>Subtotal:</span>
            <span>₹<%= invoice.subtotal.toFixed(2) %></span>
          </div>
          <div style="display:flex; justify-content:space-between; margin-bottom:8px; <%= (isEst && (!invoice.courier_charges || invoice.courier_charges == 0)) ? 'border-bottom:1px solid #e2e8f0; padding-bottom:8px;' : '' %>">
            <span>Discount:</span>
            <span>- ₹<%= invoice.discount_amount.toFixed(2) %></span>
          </div>
          <% if (invoice.courier_charges > 0) { %>
            <div style="display:flex; justify-content:space-between; margin-bottom:8px; <%= isEst ? 'border-bottom:1px solid #e2e8f0; padding-bottom:8px;' : '' %>">
              <span>Courier Charges:</span>
              <span>₹<%= parseFloat(invoice.courier_charges).toFixed(2) %></span>
            </div>
          <% } %>
          <% if (!isEst) { %>
            <div style="display:flex; justify-content:space-between; margin-bottom:8px; border-bottom:1px solid #e2e8f0; padding-bottom:8px;">
              <span>GST Tax:</span>
              <span>₹<%= invoice.tax_amount.toFixed(2) %></span>
            </div>
          <% } %>
          <div style="display:flex; justify-content:space-between; font-size:18px; font-weight:800; color:#0f172a; margin-top:8px;">
            <span>Grand Total:</span>
            <span>₹<%= invoice.total_amount.toLocaleString('en-IN', {minimumFractionDigits: 2}) %></span>
          </div>
        </div>
      </div>
      <div style="text-align:center; font-size:12px; color:#94a3b8; border-top:1px solid #e2e8f0; margin-top:40px; padding-top:16px;">
        <%= isEst ? 'This is an estimate quotation (Only valid for 7 days)' : 'Thank you for your business!' %>
      </div>
    </div>
  </div>
</div>
<script>
  function updatePrintCopyBadge() {
    const type = document.getElementById('print-copy-type').value;
    const badge = document.getElementById('print-copy-badge');
    if (!badge) return;
    if (type === 'original') {
      badge.textContent = 'Original Copy (Buyer)';
    } else if (type === 'duplicate') {
      badge.textContent = 'Duplicate Copy (Transporter)';
    } else {
      badge.textContent = 'Office Copy';
    }
  }

  async function downloadPDF() {
    const card = document.getElementById('invoice-card');
    const type = document.getElementById('print-copy-type') ? document.getElementById('print-copy-type').value : 'estimate';
    
    card.classList.add('pdf-single-page-export');

    try {
      const opt = {
        margin:       [1, 1, 1, 1], // 1mm minimal margins
        filename:     `Invoice_<%= invoice.invoice_number %>_${type}.pdf`,
        image:        { type: 'jpeg', quality: 0.98 },
        html2canvas:  { scale: 2, useCORS: true, backgroundColor: '#ffffff', scrollY: 0, scrollX: 0 },
        jsPDF:        { unit: 'mm', format: 'a6', orientation: 'portrait' }
      };

      await html2pdf().from(card).set(opt).toPdf().get('pdf').then(function(pdf) {
        // Delete any extra pages created by html2pdf so it is strictly 1 single page!
        const totalPages = pdf.internal.getNumberOfPages();
        for (let i = totalPages; i > 1; i--) {
          pdf.deletePage(i);
        }
      }).save();
    } catch(err) {
      console.error(err);
      alert('Failed to generate PDF: ' + err.message);
    } finally {
      card.classList.remove('pdf-single-page-export');
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('print') === 'true') {
      // Small timeout to ensure fonts/images are loaded before opening print dialog
      setTimeout(() => {
        window.print();
      }, 500);
    }
  });
</script>
<%- include('../partials/footer') %>