<%- include('../partials/head') %>
<%- include('../partials/sidebar', { activePage: 'billing' }) %>
<div class="main-content">
  <%- include('../partials/header', { pageTitle: 'Invoices' }) %>
  <%- include('../partials/alerts') %>
  <div class="content-area">
    <div class="mb-3 d-flex justify-between align-center">
      <form action="/billing" method="GET" class="form-inline flex-grow-1" style="max-width:850px; display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
        <input type="text" name="search" class="form-control" placeholder="Search Invoice#, Customer..." value="<%= search %>" style="max-width:180px;">
        <select name="status" class="form-control" style="max-width:130px;">
          <option value="">All Statuses</option>
          <option value="paid" <%= selectedStatus === 'paid' ? 'selected' : '' %>>Paid</option>
          <option value="pending" <%= selectedStatus === 'pending' ? 'selected' : '' %>>Pending</option>
          <option value="cancelled" <%= selectedStatus === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
        </select>
        <span style="font-size:13px; color:var(--text-secondary);">From:</span>
        <input type="date" name="from" class="form-control" value="<%= from %>" style="max-width:145px; height: 38px;">
        <span style="font-size:13px; color:var(--text-secondary);">To:</span>
        <input type="date" name="to" class="form-control" value="<%= to %>" style="max-width:145px; height: 38px;">
        <button type="submit" class="btn btn-primary" style="padding: 8px 16px;">Filter</button>
        <% if (search || selectedStatus || from || to) { %>
          <a href="/billing" class="btn btn-secondary" style="padding: 8px 16px;">Clear</a>
        <% } %>
      </form>
      <a href="/billing/new" class="btn btn-primary">+ New Invoice</a>
    </div>

    <div class="card">
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Invoice #</th>
              <th>Date</th>
              <th>Customer</th>
              <th class="text-right">Subtotal</th>
              <th class="text-right">Tax</th>
              <th class="text-right">Total Amount</th>
              <th class="text-center">Payment</th>
              <th>Status</th>
              <th class="no-print">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (invoices.length === 0) { %>
              <tr><td colspan="9" class="table-empty">No invoices found</td></tr>
            <% } %>
            <% invoices.forEach(inv => { %>
              <tr>
                <td class="fw-bold text-accent"><%= inv.invoice_number %></td>
                <td><%= new Date(inv.created_at).toLocaleDateString('en-IN') %></td>
                <td><%= inv.customer_name || 'Walk-in Customer' %></td>
                <td class="text-right">₹<%= inv.subtotal.toFixed(2) %></td>
                <td class="text-right">₹<%= inv.tax_amount.toFixed(2) %></td>
                <td class="text-right fw-bold">₹<%= inv.total_amount.toLocaleString('en-IN', {minimumFractionDigits: 2}) %></td>
                <td class="text-center text-uppercase fs-sm"><%= inv.payment_method %></td>
                <td>
                  <% if (inv.payment_status === 'paid') { %>
                    <span class="badge badge-success">Paid</span>
                  <% } else if (inv.payment_status === 'pending') { %>
                    <span class="badge badge-warning">Pending</span>
                  <% } else { %>
                    <span class="badge badge-danger">Cancelled</span>
                  <% } %>
                </td>
                <td class="no-print" style="white-space: nowrap; text-align: right;">
                  <div style="display: inline-flex; align-items: center; gap: 6px; justify-content: flex-end;">
                    <a href="/billing/<%= inv.id %>" class="btn btn-secondary btn-sm" style="padding: 5px 12px; font-size: 12px; font-weight: 600; border-radius: 6px; display: inline-flex; align-items: center;">View</a>
                    <a href="/billing/<%= inv.id %>?download=true" class="btn btn-success btn-sm" style="padding: 5px 12px; font-size: 12px; font-weight: 600; border-radius: 6px; display: inline-flex; align-items: center;" title="Download Invoice">Download</a>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <% if (pagination.totalPages > 1) { %>
        <div class="d-flex justify-between align-center p-3" style="border-top:1px solid var(--border); margin-top:10px; flex-wrap:wrap; gap:12px;">
          <div class="text-secondary" style="font-size:13px;">
            Showing Page <%= pagination.page %> of <%= pagination.totalPages %> (<%= pagination.totalInvoices || '' %> <%= pagination.totalInvoices ? 'invoices' : '' %>)
          </div>
          <div class="d-flex gap-2 align-center" style="flex-wrap:wrap;">
            <div class="pagination" style="margin:0;">
              <% 
                let startPage = Math.max(1, pagination.page - 2);
                let endPage = Math.min(pagination.totalPages, startPage + 4);
                startPage = Math.max(1, endPage - 4);
              %>
              <% if (startPage > 1) { %>
                <a href="/billing?page=1&search=<%= encodeURIComponent(search) %>&status=<%= selectedStatus %>&from=<%= from %>&to=<%= to %>">1</a>
                <% if (startPage > 2) { %><span>...</span><% } %>
              <% } %>
              
              <% for(let i=startPage; i<=endPage; i++) { %>
                <a href="/billing?page=<%= i %>&search=<%= encodeURIComponent(search) %>&status=<%= selectedStatus %>&from=<%= from %>&to=<%= to %>" class="<%= pagination.page === i ? 'active' : '' %>"><%= i %></a>
              <% } %>
              
              <% if (endPage < pagination.totalPages) { %>
                <% if (endPage < pagination.totalPages - 1) { %><span>...</span><% } %>
                <a href="/billing?page=<%= pagination.totalPages %>&search=<%= encodeURIComponent(search) %>&status=<%= selectedStatus %>&from=<%= from %>&to=<%= to %>"><%= pagination.totalPages %></a>
              <% } %>
            </div>

            <!-- Go to Page Jump -->
            <form method="GET" action="/billing" style="display:inline-flex; align-items:center; gap:6px; margin:0;">
              <% if (search) { %><input type="hidden" name="search" value="<%= search %>"><% } %>
              <% if (selectedStatus) { %><input type="hidden" name="status" value="<%= selectedStatus %>"><% } %>
              <% if (from) { %><input type="hidden" name="from" value="<%= from %>"><% } %>
              <% if (to) { %><input type="hidden" name="to" value="<%= to %>"><% } %>
              <span style="font-size:12px; color:var(--text-secondary); font-weight:600;">Go to:</span>
              <input type="number" name="page" min="1" max="<%= pagination.totalPages %>" value="<%= pagination.page %>" placeholder="#" style="width:65px; height:32px; padding:2px 8px; font-size:12px; border-radius:6px; border:1px solid var(--border); background:var(--bg-input); color:var(--text-primary); text-align:center;">
              <button type="submit" class="btn btn-secondary btn-sm" style="padding:4px 10px; font-size:12px; font-weight:600;">Go</button>
            </form>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>