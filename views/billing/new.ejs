<%- include('../partials/head') %>
<%- include('../partials/sidebar', { activePage: (typeof editInvoiceId !== 'undefined' && editInvoiceId) ? 'billing' : 'billing-new' }) %>
<div class="main-content">
  <%- include('../partials/header', { pageTitle: (typeof editInvoiceNumber !== 'undefined' && editInvoiceNumber) ? 'Edit Invoice: ' + editInvoiceNumber : 'New Invoice' }) %>
  <%- include('../partials/alerts') %>
  <div class="content-area">
    <div class="grid grid-3">
      <!-- Left 2 columns: POS Items selection & List -->
      <div style="grid-column: span 2;">
        <div class="card">
          <div class="form-group autocomplete-wrapper" style="position:relative;">
            <label for="product-search" class="fw-bold">Search Product (Code or Name)</label>
            <div class="d-flex" style="gap: 8px;">
              <input type="text" id="product-search" class="form-control" style="flex: 1;" placeholder="Type product code or name to search..." autocomplete="off">
              <button type="button" class="btn btn-primary" onclick="openQuickProdModal()" title="Add New Product" style="padding: 0 16px; font-weight: bold;">+</button>
            </div>
            <div id="product-dropdown" class="autocomplete-dropdown" style="display:none; position:absolute; width:100%; z-index:1000; background:var(--bg-card); border:1px solid var(--border); box-shadow:var(--shadow-lg); max-height:450px; overflow-y:auto; border-radius:8px; margin-top:4px;"></div>
            <div id="product-history" class="mt-2 text-muted" style="font-size: 0.85rem; display:none;"></div>
          </div>

          <div class="table-container mt-3">
            <table>
              <thead>
                <tr>
                  <th>#</th>
                  <th>Product</th>
                  <th>Qty</th>
                  <th class="text-right">Price</th>
                  <th>Discount (₹)</th>
                  <th class="text-right">Total</th>
                  <th></th>
                </tr>
              </thead>
              <tbody id="invoice-items-body">
                <tr><td colspan="7" class="table-empty">Search products to start billing</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Right column: Customer, Payment & Summary -->
      <div style="grid-column: span 1;">
        <div class="card">
          <div class="card-header d-flex justify-between align-center">
            <h3 class="card-title"><%= (typeof editInvoiceNumber !== 'undefined' && editInvoiceNumber) ? 'Edit Invoice' : 'Billing Details' %></h3>
            <% if (typeof editInvoiceNumber !== 'undefined' && editInvoiceNumber) { %>
              <span class="badge" style="background:var(--accent); color:#fff; font-size:13px; font-weight:700; padding:4px 10px; border-radius:6px;">
                Bill #: <%= editInvoiceNumber %>
              </span>
            <% } %>
          </div>
          
          <% if (typeof editInvoiceNumber !== 'undefined' && editInvoiceNumber) { %>
          <div style="background: rgba(2, 132, 199, 0.1); border: 1px solid var(--accent); border-radius: 8px; padding: 10px 14px; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center;">
            <div>
              <span style="font-size: 11px; text-transform: uppercase; color: var(--text-secondary); font-weight: 700; display: block;">Editing Bill Number</span>
              <strong style="font-size: 16px; color: var(--accent);"><%= editInvoiceNumber %></strong>
            </div>
            <span class="badge badge-warning" style="font-size: 11px; font-weight: 600;">Editing Bill</span>
          </div>
          <% } %>
          
          <div class="form-group">
            <label for="branch-select" class="fw-bold" style="color:var(--accent);">Branch</label>
            <select id="branch-select" class="form-control" onchange="onBranchChange()">
              <% if (typeof branches !== 'undefined' && branches.length > 0) { %>
                <% branches.forEach(b => { %>
                  <option value="<%= b %>"><%= b %></option>
                <% }) %>
              <% } else { %>
                <option value="">No Branches Available</option>
              <% } %>
            </select>
          </div>
          
          <div class="form-group">
            <label for="invoice-type" class="fw-bold" style="color:var(--accent);">Bill Type</label>
            <select id="invoice-type" class="form-control" onchange="onInvoiceTypeChange()">
              <option value="estimate" selected>Estimate / Quotation (Non-Tax)</option>
            </select>
          </div>
          
          <% if (user && user.role === 'admin') { %>
          <div class="form-group">
            <label for="invoice-date" class="fw-bold" style="color:var(--accent);">Invoice Date</label>
            <input type="date" id="invoice-date" class="form-control" value="<%= (typeof cloneData !== 'undefined' && cloneData && cloneData.date) ? cloneData.date : new Date().toISOString().split('T')[0] %>">
          </div>
          <% } %>

          <div class="form-group autocomplete-wrapper" style="position:relative;">
            <label for="customer-search" class="fw-bold">Customer Name / Search</label>
            <div class="d-flex" style="gap: 8px;">
              <input type="text" id="customer-search" class="form-control" style="flex: 1;" placeholder="Type name or phone (default Walk-in)" autocomplete="off">
              <button type="button" class="btn btn-primary" onclick="openQuickCustModal()" title="Add New Customer" style="padding: 0 16px; font-weight: bold;">+</button>
            </div>
            <input type="hidden" id="customer-id" value="">
            <div id="customer-dropdown" class="autocomplete-dropdown" style="display:none; position:absolute; width:100%; z-index:1000; background:var(--bg-card); border:1px solid var(--border); box-shadow:var(--shadow-lg); max-height:260px; overflow-y:auto; border-radius:8px; margin-top:4px;"></div>
            
            <!-- Selected Customer Identification Card -->
            <div id="selected-customer-card" style="display:none; background:rgba(2, 132, 199, 0.08); border:1px solid var(--accent); border-radius:8px; padding:12px 14px; margin-top:10px;">
              <div style="display:flex; justify-content:space-between; align-items:flex-start;">
                <div style="flex:1;">
                  <div style="display:flex; align-items:center; gap:8px;">
                    <strong id="card-cust-name" style="font-size:15px; color:var(--text-primary);">Customer Name</strong>
                    <span id="card-cust-gstin-badge" class="badge badge-default" style="font-size:11px; display:none;"></span>
                  </div>
                  <div id="card-cust-phone" style="font-size:13px; color:var(--text-secondary); margin-top:3px; font-weight:600;">Phone: -</div>
                  <div id="card-cust-address" style="font-size:12px; color:var(--text-secondary); margin-top:2px;">Address: -</div>
                </div>
                <button type="button" class="btn btn-secondary btn-sm" onclick="clearSelectedCustomer()" style="padding:2px 8px; font-size:11px; border-radius:4px;" title="Clear Customer">✕ Clear</button>
              </div>
            </div>
          </div>

          <!-- Outstanding Dues Section (When customer has pending balance > 0) -->
          <div id="outstanding-section" style="display:none; background: rgba(239, 68, 68, 0.1); padding: 10px 14px; border-radius: 8px; margin-top: 10px; margin-bottom: 14px; border: 1px solid var(--danger);">
            <div class="d-flex justify-between align-items-center">
              <div>
                <span class="fw-bold text-danger" style="font-size:13px;">Previous Outstanding Dues: <span id="outstanding-balance-display">₹0.00</span></span>
              </div>
              <label style="display:flex; align-items:center; gap:6px; margin:0; cursor:pointer; font-weight:600; font-size:12px; color:var(--danger);">
                <input type="checkbox" id="include-outstanding" checked onchange="calculateTotals()"> Auto-Add
              </label>
            </div>
            <input type="hidden" id="customer-outstanding-balance" value="0">
          </div>

          <!-- Advance / Overpaid Wallet Section (When customer balance < 0) -->
          <div id="wallet-section" style="display:none; background: var(--success-bg); padding: 10px 14px; border-radius: 8px; margin-top: 10px; margin-bottom: 14px; border: 1px solid var(--success);">
            <div class="d-flex justify-between align-items-center">
              <div>
                <span class="fw-bold" style="color: var(--success); font-size:13px;">Overpaid Advance (Wallet): <span id="wallet-balance-display">₹0.00</span></span>
              </div>
              <label style="display:flex; align-items:center; gap:6px; margin:0; cursor:pointer; font-weight:600; font-size:12px; color:var(--success);">
                <input type="checkbox" id="apply-wallet" checked onchange="calculateTotals()"> Auto-Minus
              </label>
            </div>
            <input type="hidden" id="customer-wallet-balance" value="0">
          </div>

          <div class="form-group">
            <label for="payment-method">Payment Method</label>
            <select id="payment-method" class="form-control">
              <option value="cash">Cash</option>
              <option value="upi">UPI / GPay</option>
              <option value="card">Card Payment</option>
              <option value="credit">Credit / Account</option>
            </select>
          </div>

          <div class="form-group">
            <label for="payment-status">Payment Status</label>
            <select id="payment-status" class="form-control">
              <option value="paid">Paid</option>
              <option value="pending">Pending</option>
            </select>
          </div>

          <div class="form-group">
            <label for="courier-charges">Delivery Charges (₹)</label>
            <input type="number" id="courier-charges" class="form-control" value="<%= typeof cloneData !== 'undefined' && cloneData && cloneData.courier_charges ? cloneData.courier_charges : 0 %>" min="0" onchange="calculateTotals()">
          </div>

          <div class="form-group">
            <label for="overall-discount">Overall Discount (₹)</label>
            <input type="number" id="overall-discount" class="form-control" value="0" min="0" onchange="calculateTotals()">
          </div>

          <div class="summary-section" style="border-top:1px solid rgba(148,163,184,0.1); padding-top:16px; margin-top:16px;">
            <div class="d-flex justify-between fs-sm text-secondary mb-1">
              <span>Subtotal:</span>
              <span id="subtotal-display">₹0.00</span>
            </div>
            <div class="d-flex justify-between fs-sm text-secondary mb-1">
              <span>Total Discount:</span>
              <span id="discount-display">₹0.00</span>
            </div>
            <div class="d-flex justify-between fs-sm text-secondary mb-1">
              <span>Delivery Charges:</span>
              <span id="courier-display">₹0.00</span>
            </div>
            <div class="d-flex justify-between fw-bold fs-xl mt-2" style="border-top:1px solid var(--border); padding-top:8px;">
              <span>Current Bill Total:</span>
              <span id="grandtotal-display">₹0.00</span>
            </div>
            <div class="d-flex justify-between fw-bold fs-sm mt-1 text-danger" id="outstanding-addition-row" style="display:none !important;">
              <span>Previous Outstanding Dues:</span>
              <span id="outstanding-addition-display">+ ₹0.00</span>
            </div>
            <div class="d-flex justify-between fw-bold fs-sm mt-1 text-success" id="wallet-deduction-row" style="display:none !important;">
              <span>Advance / Overpaid Applied:</span>
              <span id="wallet-deduction-display">- ₹0.00</span>
            </div>
            <div class="d-flex justify-between fw-bold fs-2xl text-accent mt-2" style="border-top:2px solid var(--border); padding-top:10px;">
              <span>Net Payable:</span>
              <span id="netpayable-display">₹0.00</span>
            </div>
          </div>

          <div class="form-group mt-3 p-3" style="background:var(--bg-primary); border-radius:8px; border:1px solid var(--border);">
            <label for="amount-paid" class="fw-bold fs-lg text-success">Amount Paid by Customer (₹)</label>
            <input type="number" id="amount-paid" class="form-control" style="font-size:1.25rem; font-weight:bold; color:var(--success);" value="0" min="0" step="0.01">
            <div id="change-display" class="mt-2 text-muted fw-bold fs-sm" style="display:none;">Change to Return: ₹0.00</div>
          </div>
          </div>

          <button type="button" id="submit-invoice-btn" class="btn btn-primary btn-block mt-4" onclick="submitInvoice()"><%= (typeof editInvoiceNumber !== 'undefined' && editInvoiceNumber) ? 'Update Bill (' + editInvoiceNumber + ') & Print' : 'Create Invoice & Print' %></button>
          <button type="button" class="btn btn-secondary btn-block mt-2" onclick="clearInvoice()">Clear</button>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
  const CLONE_DATA = <%- typeof cloneData !== 'undefined' && cloneData ? JSON.stringify(cloneData) : 'null' %>;
  const EDIT_INVOICE_ID = <%- typeof editInvoiceId !== 'undefined' && editInvoiceId ? editInvoiceId : 'null' %>;
</script>
<script src="/js/billing.js"></script>
<%- include('../partials/footer') %>

<!-- Quick Stock Update Modal -->
<div id="quick-stock-modal" class="modal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1050; align-items:center; justify-content:center;">
  <div class="modal-content" style="background:var(--bg-card); padding:24px; border-radius:8px; width:100%; max-width:400px; box-shadow: 0 10px 25px rgba(0,0,0,0.5); border:1px solid var(--border);">
    <h3 style="margin-top:0; color:var(--text-primary);">Out of Stock!</h3>
    <p style="color:var(--text-secondary); font-size:14px; margin-bottom:15px;">Product <strong id="quick-stock-product-name"></strong> currently has 0 stock. Add stock immediately to continue billing.</p>
    
    <input type="hidden" id="quick-stock-product-id">
    
    <div class="form-group">
      <label>Add Quantity (Purchase)</label>
      <input type="number" id="quick-stock-qty" class="form-control" min="1" value="1">
    </div>
    
    <div class="d-flex justify-between mt-4">
      <button type="button" class="btn btn-secondary" onclick="closeQuickStockModal()">Cancel & Close</button>
      <button type="button" class="btn btn-success" onclick="submitQuickStock()">Update Stock</button>
    </div>
  </div>
</div>

<!-- Quick Add Customer Modal -->
<div id="quick-customer-modal" class="modal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.6); z-index:1050; align-items:center; justify-content:center; overflow-y:auto; padding:20px 10px;">
  <div class="modal-content" style="background:var(--bg-card); padding:24px; border-radius:12px; width:100%; max-width:560px; box-shadow: 0 20px 30px rgba(0,0,0,0.5); border:1px solid var(--border);">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
      <h3 style="margin:0; font-size:18px; color:var(--text-primary);">Add New Customer Details</h3>
      <button type="button" class="btn btn-secondary btn-sm" onclick="closeQuickCustModal()" style="padding:2px 8px;">✕</button>
    </div>

    <form id="quick-cust-form" onsubmit="event.preventDefault(); submitQuickCust();">
      <div class="grid grid-2" style="gap:12px; margin-bottom:12px;">
        <div class="form-group" style="margin-bottom:0;">
          <label class="fw-bold" style="font-size:12px;">Customer Name *</label>
          <input type="text" id="quick-cust-name" class="form-control" required placeholder="e.g. John Doe / Grafix Tech">
        </div>
        <div class="form-group" style="margin-bottom:0;">
          <label class="fw-bold" style="font-size:12px;">Phone Number *</label>
          <input type="text" id="quick-cust-phone" class="form-control" required placeholder="e.g. 9876543210">
        </div>
      </div>

      <div class="form-group" style="margin-bottom:12px;">
        <label style="font-size:12px;">Address (Street / Building / Area)</label>
        <textarea id="quick-cust-address" class="form-control" rows="2" placeholder="e.g. No. 12, Anna Salai, Mount Road"></textarea>
      </div>

      <div class="grid grid-3" style="gap:12px; margin-bottom:12px;">
        <div class="form-group" style="margin-bottom:0;">
          <label style="font-size:12px;">City</label>
          <input type="text" id="quick-cust-city" class="form-control" value="Chennai" placeholder="Chennai">
        </div>
        <div class="form-group" style="margin-bottom:0;">
          <label style="font-size:12px;">State</label>
          <input type="text" id="quick-cust-state" class="form-control" value="Tamil Nadu" placeholder="Tamil Nadu">
        </div>
        <div class="form-group" style="margin-bottom:0;">
          <label style="font-size:12px;">Pincode</label>
          <input type="text" id="quick-cust-pincode" class="form-control" placeholder="600001">
        </div>
      </div>

      <div class="grid grid-2" style="gap:12px; margin-bottom:12px;">
        <div class="form-group" style="margin-bottom:0;">
          <label style="font-size:12px;">GSTIN (Optional)</label>
          <input type="text" id="quick-cust-gstin" class="form-control" placeholder="33AAAAA0000A1Z5" style="text-transform:uppercase;">
        </div>
        <div class="form-group" style="margin-bottom:0;">
          <label style="font-size:12px;">Email (Optional)</label>
          <input type="email" id="quick-cust-email" class="form-control" placeholder="customer@example.com">
        </div>
      </div>

      <div class="form-group" style="margin-bottom:16px;">
        <label style="font-size:12px;">Advance / Opening Balance (₹)</label>
        <input type="number" id="quick-cust-balance" class="form-control" value="0" step="0.01" placeholder="0.00">
        <small class="text-muted" style="font-size:11px;">Enter negative (e.g. -500) for advance wallet, or positive for credit dues.</small>
      </div>

      <div class="d-flex justify-between" style="border-top:1px solid var(--border); padding-top:14px;">
        <button type="button" class="btn btn-secondary" onclick="closeQuickCustModal()">Cancel</button>
        <button type="submit" class="btn btn-primary" style="padding:8px 20px; font-weight:700;">Save & Select Customer</button>
      </div>
    </form>
  </div>
</div>

<!-- Quick Add Product Modal -->
<div id="quick-product-modal" class="modal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1050; align-items:center; justify-content:center;">
  <div class="modal-content" style="background:var(--bg-card); padding:24px; border-radius:8px; width:100%; max-width:500px; box-shadow: 0 10px 25px rgba(0,0,0,0.5); border:1px solid var(--border);">
    <h3 style="margin-top:0; color:var(--text-primary);">Add New Product</h3>
    <div class="grid grid-2">
      <div class="form-group">
        <label>Code / Item No</label>
        <input type="text" id="quick-prod-code" class="form-control" onkeydown="if(event.key==='Enter') document.getElementById('quick-prod-name').focus()">
      </div>
      <div class="form-group">
        <label>Name</label>
        <input type="text" id="quick-prod-name" class="form-control" onkeydown="if(event.key==='Enter') document.getElementById('quick-prod-qty').focus()">
      </div>
    </div>
    <div class="grid grid-3">
      <div class="form-group">
        <label>Stock Qty</label>
        <input type="number" id="quick-prod-qty" class="form-control" value="0" onkeydown="if(event.key==='Enter') document.getElementById('quick-prod-price').focus()">
      </div>
      <div class="form-group">
        <label>Unit Price</label>
        <input type="number" id="quick-prod-price" class="form-control" value="0.00" step="0.01" onkeydown="if(event.key==='Enter') document.getElementById('quick-prod-gst').focus()">
      </div>
      <div class="form-group">
        <label>GST %</label>
        <input type="number" id="quick-prod-gst" class="form-control" value="18" onkeydown="if(event.key==='Enter') submitQuickProd()">
      </div>
    </div>
    <div class="d-flex justify-between mt-4">
      <button type="button" class="btn btn-secondary" onclick="closeQuickProdModal()">Cancel</button>
      <button type="button" class="btn btn-success" onclick="submitQuickProd()">Save & Add to Bill</button>
    </div>
  </div>
</div>